{"publishers": ["New Press"], "identifiers": {"goodreads": ["51389"], "librarything": ["248361"]}, "subtitle": "Visual Politics", "covers": [804900], "local_id": ["urn:phillips:31867007221588", "urn:sfpl:31223123530033", "urn:sfpl:31223055356902", "urn:sfpl:31223061648482", "urn:sfpl:31223123530017", "urn:sfpl:31223044493352", "urn:sfpl:31223123530009", "urn:sfpl:31223123529985", "urn:sfpl:31223123529993", "urn:sfpl:31223123530025"], "lc_classifications": ["N6537.H585 A2 1995", "N6537.H585A2 1995", "N6538.N5 H66 1995"], "key": "/books/OL1119380M", "authors": [{"key": "/authors/OL27677A"}], "publish_places": ["New York, USA"], "subjects": ["Hooks, Bell -- Philosophy", "African American art -- Political aspects"], "pagination": "xvi, 224 p. :", "classifications": {}, "source_records": ["marc:marc_records_scriblio_net/part24.dat:77575828:728", "marc:marc_cca/b10621386.out:10295945:882", "marc:marc_ithaca_college/ic_marc.mrc:157995155:727", "amazon:1565842634", "marc:marc_openlibraries_phillipsacademy/PANO_FOR_IA_05072019.mrc:47863339:1087", "marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run02.mrc:119901935:2904", "ia:artonmymindvisua0000hook", "bwb:9781565842632", "marc:marc_loc_2016/BooksAll.2016.part23.utf8:152085001:960", "ia:artonmymindvisua0000hook_g0b8", "marc:marc_columbia/Columbia-extract-20221130-004.mrc:211571621:4382", "marc:harvard_bibliographic_metadata/20220215_012.bib.mrc:14469465:4332"], "title": "Art on My Mind", "lccn": ["94045671"], "notes": "Includes bibliographical references and index.", "number_of_pages": 224, "languages": [{"key": "/languages/eng"}], "dewey_decimal_class": ["704/.0396073"], "isbn_10": ["1565842634"], "publish_date": "1995", "publish_country": "nyu", "by_statement": "Bell Hooks.", "works": [{"key": "/works/OL15053142W"}], "type": {"key": "/type/edition"}, "oclc_numbers": ["31737494"], "description": {"type": "/type/text", "value": "In Art on My Mind, bell hooks, a leading cultural critic, responds to the ongoing dialogues about producing, exhibiting, and criticizing art and aesthetics in an art world increasingly concerned with identity politics. Always concerned with the liberatory black struggle, hooks positions her writings on visual politics within the ever-present question of how art can be an empowering and revolutionary force within the black community. For this collection, hooks has written thirteen new pieces, which complement her authoritative essays on Lorna Simpson, Jean-Michel Basquiat, and Felix Gonzalez-Torres. Featured among the new pieces are interviews with and critiques of the works of Alison Saar, Carrie Mae Weems, Emma Amos, LaVerne Wells-Bowie and Margo Humphreys, as well as essays on photography, architecture, and the representation of black male bodies. -- From back cover."}, "latest_revision": 23, "revision": 23, "created": {"type": "/type/datetime", "value": "2008-04-01T03:28:50.625462"}, "last_modified": {"type": "/type/datetime", "value": "2026-06-18T17:46:02.812177"}}