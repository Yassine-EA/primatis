{"publishers": ["Belknap Press"], "isbn_10": ["0674050541"], "covers": [8481284], "lc_classifications": ["HM671.N868 2011", "HM671 .N868 2011"], "key": "/books/OL26820157M", "authors": [{"key": "/authors/OL262048A"}], "source_records": ["amazon:0674050541", "ia:creatingcapabili00nuss", "marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run04.mrc:142238929:3023", "marc:marc_claremont_school_theology/CSTMARC2_barcode.mrc:83322732:4252", "bwb:9780674050549", "marc:marc_loc_2016/BooksAll.2016.part37.utf8:166503298:1029", "marc:marc_claremont_school_theology/CSTMARC2_multibarcode.mrc:83369995:4252", "ia:creatingcapabili0000nuss", "promise:bwb_daily_pallets_2022-03-17", "marc:marc_columbia/Columbia-extract-20221130-018.mrc:14861411:1569", "marc:harvard_bibliographic_metadata/ab.bib.12.20150123.full.mrc:595305107:1140", "marc:harvard_bibliographic_metadata/20220215_067.bib.mrc:120340389:4297"], "title": "Creating Capabilities: The Human Development Approach", "lccn": ["2010044834"], "number_of_pages": 256, "isbn_13": ["9780674050549"], "local_id": ["urn:sfpl:31223095043122", "urn:sfpl:31223095043130", "urn:sfpl:31223099551054", "urn:cst:10017025028", "urn:bwbsku:P7-EUR-209"], "publish_date": "Mar 31, 2011", "works": [{"key": "/works/OL19364306W"}], "type": {"key": "/type/edition"}, "oclc_numbers": ["676725360"], "languages": [{"key": "/languages/eng"}], "description": {"type": "/type/text", "value": "This is a primer on the \"Capabilities Approach,\" Nussbaum's innovative model for assessing human progress. She argues that much humanitarian policy today violates basic human values; instead, she offers a unique means of redirecting government and development policy toward helping each of us lead a full and creative life."}, "latest_revision": 15, "revision": 15, "created": {"type": "/type/datetime", "value": "2019-03-29T09:37:45.796611"}, "last_modified": {"type": "/type/datetime", "value": "2025-05-17T12:38:23.820524"}}