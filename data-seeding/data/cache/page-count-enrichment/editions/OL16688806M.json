{"publishers": ["Gallimard"], "table_of_contents": [{"level": 0, "label": "", "title": "1. 1930-1939", "pagenum": ""}, {"level": 0, "label": "", "title": "2. 1940-1963", "pagenum": ""}], "isbn_10": ["2070718298", "2070718646"], "covers": [9963916], "local_id": ["urn:trent:0116404282737", "urn:trent:0116404284394"], "key": "/books/OL16688806M", "authors": [{"key": "/authors/OL63285A"}], "ocaid": "lettressartre0002beau", "publish_places": ["Paris, France"], "contributions": ["Sartre, Jean Paul, 1905-1980", "Le Bon de Beauvoir, Sylvie"], "pagination": "2 v. ;", "classifications": {}, "source_records": ["marc:OpenLibraries-Trent-MARCs/multi2.mrc:7905154:1087", "ia:lettressartre0002beau", "ia:lettressartre0001beau", "idb:9782070718641", "marc:marc_columbia/Columbia-extract-20221130-002.mrc:410924235:1427", "marc:harvard_bibliographic_metadata/ab.bib.01.20150123.full.mrc:825074705:1761"], "title": "Lettres à Sartre", "identifiers": {"librarything": ["443802"], "goodreads": ["152042", "1364400"]}, "languages": [{"key": "/languages/fre"}], "subjects": ["Beauvoir, Simone de, -- 1908-1986 -- Correspondence", "Sartre, Jean Paul, -- 1905-1980 -- Correspondence", "Authors, French -- 20th century -- Correspondence"], "publish_date": "1990", "publish_country": "fr ", "by_statement": "Simone de Beauvoir ; édition présentée et annotée par Sylvie Le Bon de Beauvoir", "works": [{"key": "/works/OL767920W"}], "type": {"key": "/type/edition"}, "number_of_pages": 456, "oclc_numbers": ["220812691", "21268822"], "lc_classifications": ["PQ2603.E362 Z492 1990"], "description": {"type": "/type/text", "value": "Beauvoir, \"ingénue libertaire\"? Des lettres qui racontent \"par le menu\", le quotidien de Simone de Beauvoir, ses lectures, ses fréquentations, ses loisirs et ses amours, principale (Sartre), expérimentales et contingentes (surtout des jeunes filles un peu ##paumées##). Plutôt lassant. Une sélection aurait suffi. L'auteure répète de mille façons, pas assez différentes, ce qu'elle écrit à Sartre le 10 novembre 1939: \"Je n'ai besoin que de vous et d'un peu de liberté\". Dans ##Le Monde##, J. Savigneau délire: \"un bel amour et le magnifique exercice d'une vraie liberté\""}, "latest_revision": 12, "revision": 12, "created": {"type": "/type/datetime", "value": "2008-09-25T14:56:21.014574"}, "last_modified": {"type": "/type/datetime", "value": "2025-03-21T19:59:02.003305"}}