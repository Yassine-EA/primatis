{"type": {"key": "/type/edition"}, "publish_date": "2009", "publish_country": "fr", "languages": [{"key": "/languages/fre"}], "authors": [{"key": "/authors/OL9129343A"}], "oclc_numbers": ["690402695"], "dewey_decimal_class": ["843.92"], "series": ["Points -- 2307", "Points (Paris) -- 2307."], "notes": {"type": "/type/text", "value": "Grand Prix RTL-Lire, 2009"}, "description": {"type": "/type/text", "value": "Sarah a disparu depuis un an, sans plus jamais faire signe. Pour Paul, son mari, qui vit seul avec leurs deux jeunes enfants, chaque jour est à réinventer. Il doit lutter avec sa propre inquiétude et contrer, avec une infinie tendresse, les menaces qui pèsent sur leurs vies. Epuisé, il espère se ressourcer par la grâce d'un retour à Saint-Malo, la ville de son enfance."}, "links": [{"url": "http://catalogue.bnf.fr/ark:/12148/cb421318349", "title": "Notice et cote du catalogue de la Bibliothèque nationale de France"}], "title": "Des vents contraires", "subtitle": "roman", "by_statement": "Olivier Adam", "physical_format": "[Texte imprimé] :", "publishers": ["Points"], "publish_places": ["[Paris]"], "isbn_13": ["9782757816455"], "isbn_10": ["2757816454"], "pagination": "1 vol. (282 p.)", "number_of_pages": 282, "ocaid": "desventscontrair0000adam_x4l2", "source_records": ["ia:desventscontrair0000adam_x4l2", "promise:bwb_daily_pallets_2020-07-30"], "full_title": "Des vents contraires roman", "covers": [10747913], "works": [{"key": "/works/OL24260379W"}], "key": "/books/OL32092943M", "local_id": ["urn:bwbsku:KN-619-371"], "identifiers": {"amazon": [""]}, "latest_revision": 2, "revision": 2, "created": {"type": "/type/datetime", "value": "2021-03-26T15:34:38.472893"}, "last_modified": {"type": "/type/datetime", "value": "2022-12-10T03:24:35.561448"}}