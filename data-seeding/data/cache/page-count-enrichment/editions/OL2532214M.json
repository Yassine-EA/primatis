{"description": {"type": "/type/text", "value": "Oriental Tales (French: Nouvelles orientales) is a 1938 short story collection by the French writer Marguerite Yourcenar. The stories share a self-consciously mythological form; some are based on pre-existing myths and legends, while some are new. The story \"How Wang-Fo Was Saved\" was adapted into an animated short film by René Laloux in the 1980s.\" -- www.wikipedia.com."}, "notes": {"type": "/type/text", "value": "Translation of: Nouvelles orientales."}, "identifiers": {"librarything": ["120806"], "goodreads": ["2940236"]}, "title": "Oriental tales", "authors": [{"key": "/authors/OL20371A"}], "publish_date": "1985", "publishers": ["Farrar Straus Giroux"], "table_of_contents": [{"level": 0, "title": "How Wang-Fo was saved", "type": {"key": "/type/toc_item"}}, {"level": 0, "title": "Marko's smile", "type": {"key": "/type/toc_item"}}, {"level": 0, "title": "The milk of death", "type": {"key": "/type/toc_item"}}, {"level": 0, "title": "The last love of Prince Genji", "type": {"key": "/type/toc_item"}}, {"level": 0, "title": "The man who loved the Nereids", "type": {"key": "/type/toc_item"}}, {"level": 0, "title": "Our Lady-of-the-Swallows", "type": {"key": "/type/toc_item"}}, {"level": 0, "title": "Aphrodissia, the widow", "type": {"key": "/type/toc_item"}}, {"level": 0, "title": "Kali beheaded", "type": {"key": "/type/toc_item"}}, {"level": 0, "title": "The end of Marko Kraljevic", "type": {"key": "/type/toc_item"}}, {"level": 0, "title": "The sadness of Cornelius Berg", "type": {"key": "/type/toc_item"}}, {"level": 0, "title": "Postscript.", "type": {"key": "/type/toc_item"}}], "ia_box_id": ["IA144709"], "isbn_10": ["0374227284"], "subject_place": ["Orient"], "covers": [9548393], "ia_loaded_id": ["orientaltales00marg"], "lc_classifications": ["PQ2649.O8 N7413 1985"], "ocaid": "orientaltales00marg", "publish_places": ["New York"], "edition_name": "1st ed.", "pagination": "147 p. ;", "source_records": ["marc:marc_reco