{"publishers": ["V. Hamy"], "number_of_pages": 269, "series": ["Chemins nocturnes"], "covers": [992634], "lc_classifications": ["PQ2682.A725 D43 1995"], "key": "/books/OL774535M", "authors": [{"key": "/authors/OL6926243A"}], "publish_places": ["[Paris]"], "pagination": "269 p. ;", "source_records": ["marc:marc_loc_2016/BooksAll.2016.part26.utf8:144476624:525", "ia:deboutlesmorts0000varg_a7e2", "amazon:2878580680", "promise:bwb_daily_pallets_2020-11-19", "marc:harvard_bibliographic_metadata/ab.bib.11.20150123.full.mrc:870860939:579", "marc:harvard_bibliographic_metadata/20220215_031.bib.mrc:148944565:1812"], "title": "Debout les morts", "lccn": ["97174883"], "notes": {"type": "/type/text", "value": "\"Policier\"--Cover."}, "identifiers": {"librarything": ["653610"], "goodreads": ["1810144"]}, "languages": [{"key": "/languages/fre"}], "isbn_10": ["2878580680"], "publish_date": "1995", "publish_country": "fr ", "by_statement": "Fred Vargas.", "oclc_numbers": ["34527283"], "works": [{"key": "/works/OL2497628W"}], "type": {"key": "/type/edition"}, "ocaid": "deboutlesmorts0000varg_a7e2", "local_id": ["urn:bwbsku:KO-301-082"], "description": {"type": "/type/text", "value": "Un hêtre peut-il pousser en une seule nuit dans un jardin, à Paris, sans que personne ne l'ait planté ? Oui. Chez la cantatrice Sophia Siméonidis ; et elle n'en dort plus. Puis elle disparaît sans que cela préoccupe son époux. Après une série de meurtres sinistres, ses trois voisins aidés par l'ex-flic pourri Vandoosler, découvriront les racines du hêtre, vieilles de quinze ans, grasses de haine et de jalousie."}, "latest_revision": 12, "revision": 12, "created": {"type": "/type/datetime", "value": "2008-04-01T03:28:50.625462"}, "last_modified": {"type": "/type/datetime", "value": "2026-02-17T02:24:14.168530"}}