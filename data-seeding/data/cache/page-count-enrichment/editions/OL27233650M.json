{"local_id": ["urn:sfpl:31223121798285", "urn:sfpl:31223121798228", "urn:sfpl:31223121798186", "urn:sfpl:31223121798210", "urn:sfpl:31223121798327", "urn:sfpl:31223121798277", "urn:sfpl:31223122452163", "urn:sfpl:31223122452189", "urn:sfpl:31223121798319", "urn:sfpl:31223121798293", "urn:sfpl:31223121798251", "urn:sfpl:31223121798178", "urn:sfpl:31223121798244", "urn:sfpl:31223121798335", "urn:sfpl:31223121798202", "urn:sfpl:31223121798236", "urn:sfpl:31223121798301", "urn:sfpl:31223121798194", "urn:bwbsku:P7-ALG-592"], "full_title": "Beren and Lúthien", "key": "/books/OL27233650M", "authors": [{"key": "/authors/OL26320A"}], "contributions": ["Tolkien, Christopher, editor", "Tolkien, J. R. R. (John Ronald Reuel), 1892-1973", "Lee, Alan, illustrator"], "edition_name": "First U.S. edition.", "pagination": "288 pages", "source_records": ["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run05.mrc:443408188:5123", "bwb:9781328791825", "amazon:1328791823", "promise:bwb_daily_pallets_2021-08-26", "marc:marc_columbia/Columbia-extract-20221130-026.mrc:45411830:2051", "marc:harvard_bibliographic_metadata/20220215_026.bib.mrc:289273218:4151"], "title": "Beren and Lúthien", "notes": "Includes bibliographical references.", "number_of_pages": 288, "languages": [{"key": "/languages/eng"}], "subjects": ["Middle Earth (Imaginary place)", "Fiction"], "publish_date": "2017", "publish_country": "mau", "by_statement": "by J.R.R. Tolkien ; edited by Christopher Tolkien ; with illustrations by Alan Lee", "works": [{"key": "/works/OL17755218W"}], "type": {"key": "/type/edition"}, "identifiers": {}, "isbn_10": ["1328791823"], "isbn_13": ["9781328791825"], "lccn": ["2017011980"], "oclc_numbers": ["987617974"], "ocaid": "berenlthien0000tolk", "classifications": {}, "dewey_decimal_class": ["823/.912"], "lc_classifications": ["PR6039.O32 B47 2017", "PR6039.O32B47 2017"], "publishers": ["Houghton Mifflin Harcourt"], "covers": [12639912], "description": {"type": "/type/text", "value": "Beren was a mortal man, but Lúthien was an immortal elf. Her father, a great elvish lord, in deep opposition to Beren, imposed on him an impossible task that he must perform before he might wed Lúthien. To show something of the process whereby this legend of Middle-earth evolved over the years, [Christopher Tolkien] has told the story in his father's own words by giving, first, its original form, and then passages in prose and verse from later texts that illustrate the narrative as it changed. Presented together for the first time, they reveal aspects of the story, both in event and in narrative immediacy, that were afterwards lost.--"}, "table_of_contents": [{"level": 0, "label": "", "title": "List of Plates", "pagenum": "8"}, {"level": 0, "label": "", "title": "Preface", "pagenum": "9"}, {"level": 0, "label": "", "title": "Notes on the Elder Days", "pagenum": "18"}, {"level": 0, "label": "", "title": "Beren and Lúthien", "pagenum": "27"}, {"level": 0, "label": "", "title": "Appendix", "pagenum": ""}, {"level": 1, "label": "", "title": "Revisions to The Lay of Leithian", "pagenum": "257"}, {"level": 0, "label": "", "title": "List of Names", "pagenum": "274"}, {"level": 0, "label": "", "title": "Glossary", "pagenum": "286"}], "latest_revision": 10, "revision": 10, "created": {"type": "/type/datetime", "value": "2019-07-19T22:34:51.745044"}, "last_modified": {"type": "/type/datetime", "value": "2026-01-23T06:53:31.303895"}}