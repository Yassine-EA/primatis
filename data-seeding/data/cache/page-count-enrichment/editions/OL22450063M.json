{"publishers": ["Cátedra"], "identifiers": {"goodreads": ["4635408"], "librarything": ["2620276"]}, "series": ["Letras hispánicas, 78"], "covers": [9246576, 4909192, 4409818], "key": "/books/OL22450063M", "authors": [{"key": "/authors/OL132958A"}], "publish_places": ["Madrid"], "contributions": ["Cadalso, José, 1741-1782.", "Arce, Joaquín."], "pagination": "348 p. ;", "source_records": ["marc:marc_university_of_toronto/uoft.marc:3986771680:903", "marc:OpenLibraries-Trent-MARCs/tier1.mrc:7727009:799", "marc:marc_loc_2016/BooksAll.2016.part12.utf8:69413020:724", "marc:marc_columbia/Columbia-extract-20221130-001.mrc:401372768:1167", "marc:harvard_bibliographic_metadata/ab.bib.00.20150123.full.mrc:741452447:703", "marc:harvard_bibliographic_metadata/20220215_029.bib.mrc:207916916:1290", "marc:UniversityOfMichiganMarcCatalogRecords/umich_bib.mrc:45014023:816"], "title": "Cartas marruecas / Noches lúgubres", "notes": "Bibliography: p. 61-73.", "number_of_pages": 348, "languages": [{"key": "/languages/spa"}], "local_id": ["urn:trent:0116301706317"], "publish_date": "1981", "publish_country": "sp ", "by_statement": "José Cadalso ; edición de Joaquín Arce.", "works": [{"key": "/works/OL7567258W"}], "type": {"key": "/type/edition"}, "classifications": {}, "contributors": [{"name": "Joaquín Arce", "role": "Editor"}], "physical_format": "Tapa blanda", "description": {"type": "/type/text", "value": "Las *Cartas marruecas* —publicadas en esta edición y cuyo texto se basa por primera vez en un manuscrito de la Biblioteca de la Academia de la Historia— presentan, bajo el género epistolar tan en boga desde las *Cartas persas* de Montesquieu, una visión del problema de España cuya historia, sociedad e instituciones se ponen en entredicho desde la dimensión moral. En las *Noches lúgubres*, por otra parte, Cadalso aclimata en España el llamado género sepulcral a imitación de Young. Todo ello en la que no dudaríamos de calificar la mejor prosa del siglo XVIII."}, "ocaid": "cartasmarruecasn00cad_hgy", "isbn_10": ["8437601452"], "lccn": ["79338287"], "dewey_decimal_class": ["868/.4/09"], "lc_classifications": ["PQ6510.C3 C3 1978", "PQ6510C3 A6 1981"], "oclc_numbers": ["505033871", "4882583", "6427942", "9365201"], "latest_revision": 19, "revision": 19, "created": {"type": "/type/datetime", "value": "2008-11-13T19:07:40.023240"}, "last_modified": {"type": "/type/datetime", "value": "2026-04-24T19:52:58.555343"}}