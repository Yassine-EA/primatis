{"other_titles": ["Boulevard du crime"], "publishers": ["A. Michel"], "identifiers": {"goodreads": ["121545"]}, "covers": [2148823], "lc_classifications": ["MLCS 98/03572 (P)", "PQ2679.C"], "key": "/books/OL499264M", "authors": [{"key": "/authors/OL70753A"}], "publish_places": ["Paris"], "pagination": "234 p. ;", "source_records": ["marc:marc_records_scriblio_net/part27.dat:197856883:528", "marc:marc_loc_updates/v36.i17.records.utf8:3532896:534", "marc:marc_loc_2016/BooksAll.2016.part27.utf8:155150005:534", "ia:frederickoulebou0000schm", "promise:bwb_daily_pallets_2022-03-17", "marc:marc_columbia/Columbia-extract-20221130-005.mrc:233907799:886", "marc:harvard_bibliographic_metadata/20220215_006.bib.mrc:315529055:1832"], "title": "Frédérick, ou, le Boulevard du crime", "lccn": ["98234565"], "number_of_pages": 234, "languages": [{"key": "/languages/fre"}], "isbn_10": ["2226105174"], "publish_date": "1998", "publish_country": "fr ", "by_statement": "Eric-Emmanuel Schmitt.", "oclc_numbers": ["40143998", "214305903"], "works": [{"key": "/works/OL18255887W"}], "type": {"key": "/type/edition"}, "ocaid": "frederickoulebou0000schm", "local_id": ["urn:bwbsku:T2-BXI-199"], "description": {"type": "/type/text", "value": "Au théâtre des Folies-Dramatiques, en janvier 1832, le comédien vedette Frédérick Lemaître fait un triomphe dans un mélo à la mode sur le boulevard du crime. Inquiété par la police pour ses penchants républicains, il nargue le ministre de l'Intérieur. Comédien populaire, personnage extravagant, joueur, séducteur, révolutionnaire, il semble prêt à tout sauf à l'amour."}, "latest_revision": 10, "revision": 10, "created": {"type": "/type/datetime", "value": "2008-04-01T03:28:50.625462"}, "last_modified": {"type": "/type/datetime", "value": "2025-07-01T23:37:03.024903"}}