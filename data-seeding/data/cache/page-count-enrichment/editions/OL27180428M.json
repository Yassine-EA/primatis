{"description": {"type": "/type/text", "value": "\"À un moment de ma vie, j'ai été chrétien. Cela a duré trois ans. C'est passé. Affaire classée, alors ? Il faut qu'elle ne le soit pas tout à fait pour que, vingt ans plus tard, j'aie éprouvé le besoin d'y revenir. Ces chemins du Nouveau Testament que j'ai autrefois parcourus en croyant, je les parcours aujourd'hui en romancier? en historien ? Disons en enquêteur.\"--Page [4] of cover."}, "isbn_10": ["2818021189"], "covers": [9326445], "local_id": ["urn:sfpl:31223113029830"], "lc_classifications": ["PQ2663.A7678 Z46 2014", "PQ2663.A7678 R69 2014"], "key": "/books/OL27180428M", "authors": [{"key": "/authors/OL400914A"}], "ocaid": "leroyaume0000carr", "subject_times": ["20th century", "21st century"], "isbn_13": ["9782818021187"], "pagination": "630 pages", "source_records": ["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run05.mrc:165803821:2151", "ia:leroyaume0000carr", "ia:leroyaume0000carr_d5q1", "marc:marc_loc_2016/BooksAll.2016.part41.utf8:353573488:969", "marc:harvard_bibliographic_metadata/ab.bib.14.20150123.full.mrc:269196198:1384", "marc:marc_columbia/Columbia-extract-20221130-022.mrc:228686304:598", "marc:harvard_bibliographic_metadata/20220215_020.bib.mrc:231934034:2527"], "title": "Le royaume", "lccn": ["2014493075"], "number_of_pages": 630, "languages": [{"key": "/languages/fre"}], "dewey_decimal_class": ["843"], "subjects": ["French Authors", "Jewish Christians", "Biography", "Christian civilization", "History"], "subject_people": ["Emmanuel Carrère (1957-)"], "publish_country": "fr", "publish_date": "2014", "by_statement": "Emmanuel Carrère", "oclc_numbers": ["889705394", "894003324"], "works": [{"key": "/works/OL20000330W"}], "type": {"key": "/type/edition"}, "publishers": ["P.O.L"], "latest_revision": 7, "revision": 7, "created": {"type": "/type/datetime", "value": "2019-07-18T21:05:27.452989"}, "last_modified": {"type": "/type/datetime", "value": "2025-11-01T05:52:32.521695"}}