{"publishers": ["Modern Library"], "identifiers": {"librarything": ["17714"], "goodreads": ["15981"]}, "isbn_10": ["0812968344"], "series": ["A Modern Library 20th century rediscovery"], "pagination": "ix, 404 p. ;", "covers": [606068], "lc_classifications": ["PS3565.A8 G3 2003", "PS3565.A8G3 2003"], "key": "/books/OL3565364M", "authors": [{"key": "/authors/OL32981A"}], "ocaid": "gardenofearthlyd00oate_0", "publish_places": ["New York"], "lccn": ["2002038012"], "uri_descriptions": ["Contributor biographical information", "Sample text", "Publisher description"], "edition_name": "Modern Library pbk. ed.", "genres": ["Fiction."], "source_records": ["marc:marc_records_scriblio_net/part14.dat:34229253:1287", "marc:marc_ithaca_college/ic_marc.mrc:195654477:1059", "ia:gardenofearthlyd00oate_0", "bwb:9780812968347", "marc:marc_loc_2016/BooksAll.2016.part29.utf8:198787595:1287", "marc:marc_columbia/Columbia-extract-20221130-009.mrc:117272243:2169", "marc:harvard_bibliographic_metadata/ab.bib.09.20150123.full.mrc:117851110:1096", "marc:harvard_bibliographic_metadata/20220215_039.bib.mrc:347469455:5215"], "title": "A garden of earthly delights", "url": ["http://www.loc.gov/catdir/bios/random054/2002038012.html", "http://www.loc.gov/catdir/samples/random041/2002038012.html", "http://www.loc.gov/catdir/description/random042/2002038012.html"], "notes": {"type": "/type/text", "value": "\"Revised and rewritten\"--Cover."}, "number_of_pages": 404, "languages": [{"key": "/languages/eng"}], "dewey_decimal_class": ["813/.54"], "subjects": ["Children of migrant laborers -- Fiction", "Fathers and daughters -- Fiction", "Illegitimate children -- Fiction", "Mothers and sons -- Fiction", "Poor women -- Fiction"], "publish_date": "2003", "publish_country": "nyu", "by_statement": "Joyce Carol Oates ; afterword by the author.", "works": [{"key": "/works/OL14958466W"}], "type": {"key": "/type/edition"}, "uris": ["http://www.loc.gov/catdir/bios/random054/2002038012.html", "http://www.loc.gov/catdir/samples/random041/2002038012.html", "http://www.loc.gov/catdir/description/random042/2002038012.html"], "oclc_numbers": ["50803505"], "description": {"type": "/type/text", "value": "\"In her second novel, Joyce Carol Oates created one of her most memorable heroines, Clara, the beautiful daughter of migrant farmworkers. Intent upon rising above her haphazard life of violence and poverty, Clara struggles for independence while relying on four men to fashion her destiny: her father, a hardened laborer simmering with resentment; Lowry, who rescues the teenage Clara from her family and offers her a first glimpse of love; Revere, the wealthy married man who promises Clara stability; and Swan, Clara's son, who bears the burden of his mother's mistaken identity.\"--Jacket."}, "latest_revision": 15, "revision": 15, "created": {"type": "/type/datetime", "value": "2008-04-01T03:28:50.625462"}, "last_modified": {"type": "/type/datetime", "value": "2026-05-29T03:20:41.933246"}}