{"notes": {"type": "/type/text", "value": "Includes index."}, "identifiers": {"librarything": ["6168769"], "goodreads": ["2025821", "11913"]}, "title": "Conversations with Saul Bellow", "authors": [{"key": "/authors/OL33600A"}], "publish_date": "1994", "publishers": ["University Press of Mississippi"], "isbn_10": ["087805717X", "0878057188"], "series": ["Literary conversations series"], "covers": [1631135], "lc_classifications": ["PS3503.E4488 Z55 1994", "PS3503.E4488Z55 1994"], "publish_places": ["Jackson"], "contributions": ["Cronin, Gloria L., 1947-", "Siegel, Ben, 1925-"], "subject_time": ["20th century"], "pagination": "xx, 303 p. :", "source_records": ["promise:bwb_daily_pallets_2022-05-11:W7-BZO-528", "marc:marc_records_scriblio_net/part24.dat:55881297:892", "marc:talis_openlibrary_contribution/talis-openlibrary-contribution.mrc:1576254866:675", "bwb:9780878057184", "marc:marc_loc_2016/BooksAll.2016.part23.utf8:130379254:892", "bwb:9780878057177", "marc:marc_columbia/Columbia-extract-20221130-004.mrc:101126006:3649", "marc:harvard_bibliographic_metadata/20220215_015.bib.mrc:56494463:1988"], "dewey_decimal_class": ["813/.52", "B"], "languages": [{"key": "/languages/eng"}], "lccn": ["94019474"], "subjects": ["Bellow, Saul -- Interviews", "Authors, American -- 20th century -- Biography"], "publish_country": "msu", "by_statement": "edited by Gloria L. Cronin and Ben Siegel.", "type": {"key": "/type/edition"}, "local_id": ["urn:bwbsku:W7-BZO-528"], "key": "/books/OL1094981M", "number_of_pages": 303, "works": [{"key": "/works/OL506016W"}], "oclc_numbers": ["30623728"], "description": {"type": "/type/text", "value": "For over forty years Saul Bellow has been writing fiction that denounces the destructive forces that have dominated the literature of this century - existential nihilism and historicist pessimism. In novel after novel - The Adventures of Augie March, Herzog, Humboldt's Gift, Mr. Sammler's Planet, and others - he has tried to restore the integrity of the private life, the value of human feeling, and the primacy of social contract and proclaimed each individual's perennial access to age-old truths."}, "latest_revision": 18, "revision": 18, "created": {"type": "/type/datetime", "value": "2008-04-01T03:28:50.625462"}, "last_modified": {"type": "/type/datetime", "value": "2025-08-28T05:58:45.499985"}}