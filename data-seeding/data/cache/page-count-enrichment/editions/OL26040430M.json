{"publishers": ["Penguin Books Ltd"], "source_records": ["ia:embassyofcambodi0000smit", "marc:marc_loc_2016/BooksAll.2016.part41.utf8:100472040:647", "bwb:9780241146521", "marc:marc_columbia/Columbia-extract-20221130-022.mrc:26840327:807", "idb:9780241146521", "marc:harvard_bibliographic_metadata/ab.bib.13.20150123.full.mrc:949249623:1504", "marc:harvard_bibliographic_metadata/20220215_021.bib.mrc:250530961:2553"], "title": "Embassy Of Cambodia", "lccn": ["2013487748"], "identifiers": {}, "covers": [7613590], "isbn_13": ["9780241146521"], "lc_classifications": ["PR6069.M59 E43 2013", "PR6069.M59", "PR6069.M59 E53 2013"], "publish_date": "2013", "key": "/books/OL26040430M", "ocaid": "embassyofcambodi0000smit", "works": [{"key": "/works/OL17455685W"}], "type": {"key": "/type/edition"}, "oclc_numbers": ["858005312"], "number_of_pages": 96, "description": {"type": "/type/text", "value": "Zadie Smith takes us deep into the life of a young woman, Fatou, domestic servant to the Derawals and escapes from one set of hardships to another. Beginning and ending outside the Embassy of Cambodia, which happens to be located in Willesden, NW London, Zadie Smith's absorbing, moving and wryly observed story suggests how the apparently small things in an ordinary life always raise larger, more extraordinary questions."}, "languages": [{"key": "/languages/eng"}], "latest_revision": 9, "revision": 9, "created": {"type": "/type/datetime", "value": "2016-10-14T09:35:39.884497"}, "last_modified": {"type": "/type/datetime", "value": "2025-11-13T23:23:01.385304"}}