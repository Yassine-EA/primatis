{"type": {"key": "/type/edition"}, "publish_date": "2015", "copyright_date": "2014", "publish_country": "fr", "languages": [{"key": "/languages/fre"}], "authors": [{"key": "/authors/OL9128280A"}], "oclc_numbers": ["930336054"], "series": ["Kilimax", "Kilimax"], "description": {"type": "/type/text", "value": "Valentin est un chat comme tous les autres chats, mais rouge. A cause de cela, il est rejeté et obligé de se cacher dans la forêt. Jusqu'au jour où il rencontre une jolie chatte blanche comme la neige... L'album permet d'aborder les questions de la différence et du rejet, de l'amitié et de la solidarité."}, "subjects": ["Livres illustrés pour enfants", "Loup", "Ouvrages pour la jeunesse", "Sorcières", "Différence (philosophie)"], "title": "Le chat rouge", "by_statement": "Grégoire Solotareff", "publishers": ["l'Ecole des loisirs"], "publish_places": ["Paris"], "isbn_13": ["9782211224642"], "isbn_10": ["2211224644"], "pagination": "1 vol. (non  paginé [30] p.)", "number_of_pages": 30, "ocaid": "lechatrouge0000solo", "source_records": ["ia:lechatrouge0000solo", "promise:bwb_daily_pallets_2020-12-14"], "covers": [10993226], "works": [{"key": "/works/OL24428580W"}], "key": "/books/OL32356362M", "local_id": ["urn:bwbsku:KO-612-626"], "latest_revision": 2, "revision": 2, "created": {"type": "/type/datetime", "value": "2021-05-08T18:02:16.720793"}, "last_modified": {"type": "/type/datetime", "value": "2022-12-09T07:59:36.982650"}}