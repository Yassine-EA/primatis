google.com/books/about/The_Story_of_Apollo_11.html?hl=&id=QqByjR4d1KoC"}, "saleInfo": {"country": "BE"}, "accessInfo": {"country": "BE", "epub": {"isAvailable": false}, "pdf": {"isAvailable": false}, "accessViewStatus": "NONE"}, "searchInfo": {"textSnippet": "Highlights man&#39;s efforts to journey to the moon, with a detailed account of the first landing achieved by Apollo 11."}}, {"kind": "books#volume", "id": "bEN4swEACAAJ", "etag": "8Ofywz19sYY", "selfLink": "https://www.googleapis.com/books/v1/volumes/bEN4swEACAAJ", "volumeInfo": {"title": "Apollo 11 and the First Men on the Moon", "authors": ["Eric Keppeler"], "publisher": "PowerKids Press", "publishedDate": "2018-08", "readingModes": {"text": false, "image": false}, "maturityRating": "NOT_MATURE", "allowAnonLogging": false, "contentVersion": "preview-1.0.0", "panelizationSummary": {"containsEpubBubbles": false, "containsImageBubbles": false}, "previewLink": "http://books.google.be/books?id=bEN4swEACAAJ&dq=intitle:%22Moonwalk,+the+story+of+Apollo+11%22+inauthor:%22Erich+Fuchs%22&hl=&as_pt=BOOKS&cd=7&source=gbs_api", "infoLink": "http://books.google.be/books?id=bEN4swEACAAJ&dq=intitle:%22Moonwalk,+the+story+of+Apollo+11%22+inauthor:%22Erich+Fuchs%22&hl=&as_pt=BOOKS&source=gbs_api", "canonicalVolumeLink": "https://books.google.com/books/about/Apollo_11_and_the_First_Men_on_the_Moon.html?hl=&id=bEN4swEACAAJ"}, "saleInfo": {"country": "BE"}, "accessInfo": {"country": "BE", "epub": {"isAvailable": false}, "pdf": {"isAvailable": false}, "accessViewStatus": "NONE"}}, {"kind": "books#volume", "id": "Uc-UDwAAQBAJ", "etag": "r+cTuxtted8", "selfLink": "https://www.googleapis.com/books/v1/volumes/Uc-UDwAAQBAJ", "volumeInfo": {"title": "Moon Mission", "subtitle": "The Epic 400-Year Journey to Apollo 11", "authors": ["Sigmund Brouwer"], "publisher": "Kids Can Press Ltd", "publishedDate": "2019-05-07", "description": "A unique look at the successful — though nearly disastrous — Apollo 11 moon landing! In a riveting narrative told from the astronauts’ points of view, readers get to relive every step of Apollo 11’s 1969 mission — from ignition to moon walk to splashdown — including the nail-biting (and relatively unknown) crucial moments when it came close to failure. And, setting this book apart, each step is linked to the innovations and discoveries from the past four centuries that made it possible. It’s a fascinating new perspective on an epic journey — and how STEM set it in motion! Readers better fasten their seat belts, they’re in for the ride of a lifetime!", "readingModes": {"text": false, "image": true}, "maturityRating": "NOT_MATURE", "allowAnonLogging": false, "contentVersion": "1.2.2.0.preview.1", "panelizationSummary": {"containsEpubBubbles": false, "containsImageBubbles": false}, "imageLinks": {"smallThumbnail": "http://books.google.com/books/content?id=Uc-UDwAAQBAJ&printsec=frontcover&img=1&zoom=5&edge=curl&source=gbs_api", "thumbnail": "http://books.google.com/books/content?id=Uc-UDwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"}, "previewLink": "http://books.google.be/books?id=Uc-UDwAAQBAJ&printsec=frontcover&dq=intitle:%22Moonwalk,+the+story+of+Apollo+11%22+inauthor:%22Erich+Fuchs%22&hl=&as_pt=BOOKS&cd=8&source=gbs_api", "infoLink": "https://play.google.com/store/books/details?id=Uc-UDwAAQBAJ&source=gbs_api", "canonicalVolumeLink": "https://play.google.com/store/books/details?id=Uc-UDwAAQBAJ"}, "saleInfo": {"country": "BE", "listPrice": {"amount": 18.59, "currencyCode": "EUR"}, "retailPrice": {"amount": 13.01, "currencyCode": "EUR"}, "buyLink": "https://play.google.com/store/books/details?id=Uc-UDwAAQBAJ&rdid=book-Uc-UDwAAQBAJ&rdot=1&source=gbs_api", "offers": [{"finskyOfferType": 1, "listPrice": {"amountInMicros": 18590000, "currencyCode": "EUR"}, "retailPrice": {"amountInMicros": 13010000, "currencyCode": "EUR"}}]}, "accessInfo": {"country": "BE", "epub": {"isAvailable": false}, "pdf": {"isAvailable": true, "acsTokenLink": "http://books.google.be/books/download/Moon_Mission-sample-pdf.acsm?id=Uc-UDwAAQBAJ&format=pdf&output=acs4_fulfillment_token&dl_type=sample&source=gbs_api"}, "accessViewStatus": "SAMPLE"}, "searchInfo": {"textSnippet": "And, setting this book apart, each step is linked to the innovations and discoveries from the past four centuries that made it possible. It’s a fascinating new perspective on an epic journey — and how STEM set it in motion!"}}, {"kind": "books#volume", "id": "vnN9DwAAQBAJ", "etag": "33DpAzXflZg", "selfLink": "https://www.googleapis.com/books/v1/volumes/vnN9DwAAQBAJ", "volumeInfo": {"title": "Apollo 11", "subtitle": "The Inside Story", "authors": ["David Whitehouse"], "publisher": "Icon Books", "publishedDate": "2019-06-06", "description": "'Terrific and enthralling' New Scientist Fifty years ago, in July 1969, Apollo 11 became the first manned mission to land on the Moon, and Neil Armstrong the first man to step on to its surface. He and his crewmates, Buzz Aldrin and Michael Collins, were the latest men to risk their lives in this extraordinary scientific, engineering and human venture that would come to define the era. In Apollo 11: The Inside Story, David Whitehouse reveals the true drama behind the mission, putting it in the context of the wider space race and telling the story in the words of those who took part – based around exclusive interviews with the key players. This enthralling book takes us from the early rocket pioneers to the shock America received from the Soviets' launch of the first satellite, Sputnik; from the race to put the first person into space to the iconic Apollo 11 landing and beyond, to the agonising drama of the Apollo 13 disaster and the eventual winding-up of the Apollo program. Here is the story as told by the crew of Apollo 11 and the many others who shared in their monumental endeavour. Astronauts, engineers, politicians, NASA officials, Soviet rivals – all tell their own story of a great moment of human achievement.", "readingModes": {"tex